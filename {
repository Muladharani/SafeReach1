const test = async () = const baseUrl = 'http://localhost:5000'; const res1 = await fetch(baseUrl + '/api/shelters', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: 'Test Shelter', address: '123 Test St', city: 'Test City', capacity: 100, currentOccupancy: 0, phone: '555-0100', latitude: 10.0, longitude: 20.0, facilities: ['food', 'water'] }) }); const shelter = await res1.json(); console.log('CREATE:', shelter); const res2 = await fetch(baseUrl + '/api/shelters/' + shelter.id); console.log('GET:', await res2.json()); const res3 = await fetch(baseUrl + '/api/shelters/' + shelter.id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ currentOccupancy: 5 }) }); console.log('UPDATE:', await res3.json()); const res4 = await fetch(baseUrl + '/api/shelters/' + shelter.id, { method: 'DELETE' }); console.log('DELETE:', res4.status); const res5 = await fetch(baseUrl + '/api/shelters'); console.log('LIST:', await res5.json()); }; test();
