# Current SafeReach demo
# Replit provides DATABASE_URL to the API workflow; do not commit a real value.

# Optional values for a future Supabase migration (not read by the current demo).
SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secret. Store this in Replit Secrets, never in a VITE_ variable
# and never expose it to browser code.
SUPABASE_SECRET_KEY=sb_secret_replace_me
